# This is an example environment file. Copy it to .env and fill in your actual values.

# ============================================================================
# ⚠️  FORK TESTING RPC CONFIGURATION
# ============================================================================
# WARNING: Public RPC URLs may be rate-limited and cause fork test failures
# Consider using private RPC providers (Alchemy, Infura, etc.) for reliable testing
# Fork tests may timeout or fail with public RPCs due to rate limiting

# Format: RPC_URL_<chainid> and RPC_URL_<chainid>_BACKUP for failover

# Ethereum Mainnet (chainid 1) *** OPTIONAL ***
RPC_URL_1=https://eth.llamarpc.com
RPC_URL_1_BACKUP=https://ethereum.publicnode.com

# Ethereum Sepolia (chainid 11155111)
RPC_URL_11155111=https://ethereum-sepolia-rpc.publicnode.com
RPC_URL_11155111_BACKUP=https://rpc.sepolia.org

# Arbitrum Mainnet (chainid 42161) *** OPTIONAL ***
RPC_URL_42161=https://arbitrum.llamarpc.com
RPC_URL_42161_BACKUP=https://arbitrum.publicnode.com

# Arbitrum Sepolia (chainid 421614)
RPC_URL_421614=https://sepolia-rollup.arbitrum.io/rpc
RPC_URL_421614_BACKUP=https://arbitrum-sepolia.public.blastapi.io

# Unichain Mainnet (chainid 130)    *** OPTIONAL ***
RPC_URL_130=https://rpc.unichain.org
RPC_URL_130_BACKUP=https://rpc-mainnet.unichain.org

# Unichain Sepolia (chainid 1301)
RPC_URL_1301=https://sepolia.unichain.org
RPC_URL_1301_BACKUP=https://rpc-sepolia.unichain.org

# Local Anvil (chainid 31337)
RPC_URL_31337=http://localhost:8545
RPC_URL_31337_BACKUP=http://127.0.0.1:8545

# ============================================================================
# 🔑 DEPLOYMENT CONFIGURATION
# ============================================================================

#### Deployment Keys and RPCs #################################
# Local Anvil (chainid 31337)
DEPLOYMENT_WALLET_31337=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
DEPLOYMENT_KEY_31337=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Arbitrum Sepolia (chainid 421614)
DEPLOYMENT_KEY_421614=
EXPLORER_URL_421614=https://arbitrum-sepolia.blockscout.com

# Unichain Sepolia Testnet (chainid 1301)
DEPLOYMENT_KEY_1301=
EXPLORER_URL_1301=https://unichain-sepolia.blockscout.com

# Arbitrum Mainnet (chainid 42161)      
DEPLOYMENT_KEY_42161=
EXPLORER_URL_42161=https://arbitrum.blockscout.com/

# Unichain Mainnet (chainid 130)
DEPLOYMENT_KEY_130=

# The deployment script will select the correct key and RPC URL based on block.chainid
# You can add more chains as needed using the same pattern

#### Wallets for different use cases ##################################
# If you lack addresses, can assign same address multiple times 

# Deployer needs to own native tokens. Will also be owner of all deployed contracts
DEPLOYMENT_WALLET=0x                # Here for the focus chain
DEPLOYMENT_KEY=0x                   # Here for the focus chain
DEPLOYMENT_PRIVATE_KEY=0x           # Can use same key as above
PRIVATE_KEY=0x                      # Can use same key as above

# Pool creator needs native tokens for gas and should have USDC for initial liquidity
POOL_CREATION_WALLET=0x
POOL_CREATION_PRIVATE_KEY=0x

# Swapper needs tokens for both sides of the pool
SWAPPER_WALLET=0x
SWAPPER_PRIVATE_KEY=0x

# Liquidity provider needs tokens for both sides of the pool
LIQUIDITY_PROVIDER_WALLET=0x
LIQUIDITY_PROVIDER_PRIVATE_KEY=0x

# Anvil test accounts (funded with 10000 ETH each) - for local testing
# Account 0 (default deployer)
ANVIL_ACCOUNT_0_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
ANVIL_ACCOUNT_0_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Account 1 (pool creator)
ANVIL_ACCOUNT_1_ADDRESS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8
ANVIL_ACCOUNT_1_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# Account 2 (swapper)
ANVIL_ACCOUNT_2_ADDRESS=0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC
ANVIL_ACCOUNT_2_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a

# Account 3 (liquidity provider)
ANVIL_ACCOUNT_3_ADDRESS=0x90F79bf6EB2c4f870365E785982E1f101E93b906
ANVIL_ACCOUNT_3_PRIVATE_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6

# ***********************************************************************************************
# Optional: Etherscan API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here