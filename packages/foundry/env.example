# This is an example environment file. Copy it to .env and fill in your actual values.

# ============================================================================
# ⚠️  FORK TESTING RPC CONFIGURATION
# ============================================================================
# WARNING: Public RPC URLs may be rate-limited and cause fork test failures
# Consider using private RPC providers (Alchemy, Infura, etc.) for reliable testing
# Fork tests may timeout or fail with public RPCs due to rate limiting

# Format: RPC_URL_<chainid> and RPC_URL_<chainid>_BACKUP for failover

# Ethereum Mainnet (chainid 1) *** OPTIONAL ***
RPC_URL_1=https://eth.llamarpc.com
RPC_URL_1_BACKUP=https://ethereum.publicnode.com

# Ethereum Sepolia (chainid 11155111)
RPC_URL_11155111=https://ethereum-sepolia-rpc.publicnode.com
RPC_URL_11155111_BACKUP=https://rpc.sepolia.org

# Arbitrum Mainnet (chainid 42161) *** OPTIONAL ***
RPC_URL_42161=https://arbitrum.llamarpc.com
RPC_URL_42161_BACKUP=https://arbitrum.publicnode.com

# Arbitrum Sepolia (chainid 421614)
RPC_URL_421614=https://sepolia-rollup.arbitrum.io/rpc
RPC_URL_421614_BACKUP=https://arbitrum-sepolia.public.blastapi.io

# Unichain Mainnet (chainid 130)    *** OPTIONAL ***
RPC_URL_130=https://rpc.unichain.org
RPC_URL_130_BACKUP=https://rpc-mainnet.unichain.org

# Unichain Sepolia (chainid 1301)
RPC_URL_1301=https://sepolia.unichain.org
RPC_URL_1301_BACKUP=https://rpc-sepolia.unichain.org

# Local Anvil (chainid 31337)
RPC_URL_31337=http://localhost:8545
RPC_URL_31337_BACKUP=http://127.0.0.1:8545

# ============================================================================
# 🔑 DEPLOYMENT CONFIGURATION
