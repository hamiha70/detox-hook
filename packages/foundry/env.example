EXPLORER_URL_1="https://blockscout.com"
VERIFIER_URL_1="https://blockscout.com/api"

# The deployment script will select the correct key and RPC URL based on block.chainid
# You can add more chains as needed using the same pattern

#### Wallets for different use cases ##################################
# If you lack addresses, can assign same address multiple times 

# Deployer needs to own native tokens. Will also be owner of all deployed contracts
DEPLOYMENT_WALLET=0x                # Here for the focus chain
DEPLOYMENT_KEY=0x                   # Here for the focus chain
DEPLOYMENT_PRIVATE_KEY=0x           # Can use same key as above
PRIVATE_KEY=0x                      # Can use same key as above

# Pool creator needs native tokens for gas and should have USDC for initial liquidity
POOL_CREATION_WALLET=0x
POOL_CREATION_PRIVATE_KEY=0x

# Swapper needs tokens for both sides of the pool
SWAPPER_WALLET=0x
SWAPPER_PRIVATE_KEY=0x

# Liquidity provider needs tokens for both sides of the pool
LIQUIDITY_PROVIDER_WALLET=0x
LIQUIDITY_PROVIDER_PRIVATE_KEY=0x

# Anvil test accounts (funded with 10000 ETH each) - for local testing
# Account 0 (default deployer)
ANVIL_ACCOUNT_0_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
ANVIL_ACCOUNT_0_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

